{
  "name": "east-forsyth-band-site",
  "private": true,
  "scripts": {
    "build": "npm run build:pages",
    "test:worker": "node --test tests/test_worker_backend.mjs",
    "test:pages-build": "node --test tests/test_pages_build.mjs",
    "test:cms-guide-pdf": "node --test tests/test_cms_guide_pdf.mjs",
    "build:cms-guide-pdf": "node worker/scripts/build-cms-guide-pdf.mjs",
    "sync:worker-assets": "node worker/scripts/sync-public.mjs",
    "build:pages": "npm run sync:worker-assets && node worker/scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name=efhsband",
    "deploy:worker": "npm run sync:worker-assets && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.118.0"
  }
}
